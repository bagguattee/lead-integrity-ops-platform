# Database Configuration (Docker PostgreSQL 16 locally, or Neon/Supabase PostgreSQL on Vercel)
# Run `docker compose up -d` to launch the bundled PostgreSQL 16 container on port 5433:
DATABASE_URL="postgresql://integrityops:integrityops_dev_password@localhost:5433/integrityops?schema=public"

# Session & Authentication Secret (must be 32+ characters)
SESSION_SECRET="complex_password_at_least_32_characters_long_for_security_123456"

# App Public URL (e.g. https://your-domain.vercel.app or http://localhost:3005)
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# Webhook Shared Signing Secret (used for verifying n8n HMAC-SHA256 signatures)
WEBHOOK_DEFAULT_SECRET="whsec_enterprise_resilient_pipeline_secret_test_key"

# Optional LLM Key for Fast Triage (Groq fast inference)
GROQ_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Vapi Voice AI Configuration (Optional for Live PSTN Telephony)
# ─────────────────────────────────────────────────────────────────────────────
# When VAPI_PHONE_NUMBER_ID is omitted, the console runs in Interactive 2-Way
# Simulator Mode ($0.00 cost) while still exposing live `POST /api/webhooks/vapi`.
VAPI_API_KEY=""
VAPI_ASSISTANT_ID=""
VAPI_PHONE_NUMBER_ID=""
VAPI_WEBHOOK_SECRET="whsec_vapi_voice_ai_lead_qualification_audit"
